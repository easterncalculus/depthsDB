// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum CardSide {
  dungeon
  hero
  neutral
}

enum CardType {
  heroIdentity
  heroAsset
  heroEvent
  dungeonForm
  dungeonVariant
  dungeonRoom
  neutralInfo
}

enum HeroArchetype {
  warrior
  mage
  adventurer
}

enum DungeonArchetype {
  maze
  tomb
  fortress
  cavern
}

enum ExitType {
  North
  East
  South
  West
  Special
}

enum RuleType {
  General
  Archetype
  Type
  Subtype
  Keyword
}

model Card {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  imageUrl          String?
  side              CardSide
  type              CardType
  subtypes          String            // Stored as comma-separated values
  
  // Hero card specific fields
  heroArchetype     HeroArchetype?
  manaCost          Int?              // For heroCardEvent
  
  // Dungeon card specific fields
  dungeonArchetype  DungeonArchetype?
  exits             String?           // For dungeonCardRoom, stored as comma-separated ExitType values
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Rule {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  type              RuleType
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
