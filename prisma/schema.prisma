// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Note: SQLite doesn't support enums, so we use String type instead
// but add comments to document the allowed values

model Card {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  imageUrl          String?
  
  // Values: "dungeon", "hero", "neutral"
  side              String           
  
  // Values: "heroIdentity", "heroAsset", "heroEvent", "dungeonForm", "dungeonVariant", "dungeonRoom", "neutralInfo"
  type              String           
  
  // Stored as comma-separated values
  subtypes          String            
  
  // Hero card specific fields
  // Values: "warrior", "mage", "adventurer"
  heroArchetype     String?           
  manaCost          Int?              // For heroCardEvent
  
  // Dungeon card specific fields
  // Values: "maze", "tomb", "fortress", "cavern"
  dungeonArchetype  String?           
  
  // For dungeonCardRoom, stored as comma-separated values
  // Values: "North", "East", "South", "West", "Special"
  exits             String?           
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Rule {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  
  // Values: "General", "Archetype", "Type", "Subtype", "Keyword"
  type              String
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}